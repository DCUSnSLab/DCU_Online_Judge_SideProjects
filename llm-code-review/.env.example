# LLM profile selected by dcu_llm when --profile is not passed (default: onprem).
DCU_LLM_PROFILE=onprem

# On-prem Qwen — required to call https://code.cu.ac.kr/llm/v1
ONPREM_API_KEY=

# Optional overrides (defaults shown):
# ONPREM_BASE_URL=https://code.cu.ac.kr/llm/v1
# ONPREM_DEFAULT_MODEL=Qwen/Qwen3.5-35B-A3B-FP8
